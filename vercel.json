{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "talk/targets.json"
    },
    "api/decide.js": {
      "maxDuration": 10,
      "includeFiles": "talk/targets.json"
    },
    "api/learn.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin?path="
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/learn",
      "schedule": "0 9 * * *"
    }
  ]
}
